<Application x:Class="AmberSigenergy.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Color x:Key="AccentColor">#D99A32</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#20242B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9BA4B0"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Application.Resources>
</Application>
