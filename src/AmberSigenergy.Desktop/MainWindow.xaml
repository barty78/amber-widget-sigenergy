<Window x:Class="AmberSigenergy.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="AmberSigenergy.ico" Title="Amber + Sigenergy" Height="960" Width="1180"
        MinHeight="650" MinWidth="960" WindowState="Maximized"
        Background="#15181D" WindowStartupLocation="CenterScreen" Closing="MainWindow_Closing">
    <Grid Margin="14" MinWidth="960">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.85*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="ENERGY CONTROL" Foreground="#D99A32" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="Amber + Sigenergy" FontSize="30" FontWeight="SemiBold" Margin="0,3,0,0"/>
                <TextBlock Text="EC 10.0 SP  ·  40 kWh battery" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="AmberConnectButton" DockPanel.Dock="Right" Content="Amber · connect" Click="ConnectAmber_Click" Padding="10,6" Margin="0,0,2,0" Background="#252A32" Foreground="#E8B65B" BorderBrush="#66502C" BorderThickness="1" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="Connect or reconnect Amber"/>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="4" Height="82" Margin="0,0,0,10">
            <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="IMPORT PRICE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="ImportPriceText" Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,2,0,0"/><TextBlock Text="c/kWh · Amber general" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="10" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="EXPORT PRICE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="ExportPriceText" Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,2,0,0"/><TextBlock Text="c/kWh · Amber feed-in" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="EARNED TODAY" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="EarnedTodayText" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="Gross export credit estimate" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12">
                <StackPanel><TextBlock Text="IMPORT COST TODAY" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="ImportCostTodayText" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="Gross usage cost estimate" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2" MinHeight="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="14" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="LIVE ENERGY FLOW" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Live inverter readings · read-only Modbus TCP." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,4" FontSize="11"/>
                    </StackPanel>
                    <TextBlock Text="Live inverter readings · read-only Modbus TCP." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8" FontSize="11"/>
                    <Grid Grid.Row="1" MinHeight="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="0.8*"/><RowDefinition Height="1.2*"/></Grid.RowDefinitions>
                        <Border Grid.Column="0" Grid.Row="0" Background="#30291F" CornerRadius="12" Padding="12" Margin="0,4,6,4">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="☀  SOLAR" Foreground="#E5B04C" FontWeight="Bold" FontSize="12"/>
                                <TextBlock x:Name="SolarPowerText" Text="— kW" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                <TextBlock Text="PV generation" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="1" Grid.Row="0" Text="→" Foreground="#E5B04C" FontSize="22" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Background="#252D35" BorderBrush="#46515D" BorderThickness="1" CornerRadius="14" Padding="16" Margin="2,4">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="⌂  HOME" Foreground="#D8E0E8" FontWeight="Bold" FontSize="13"/>
                                <TextBlock x:Name="HomeLoadText" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,9"/>
                                <TextBlock Text="LIVE LOAD" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                <TextBlock Text="Estimated from power balance" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="3" Grid.Row="0" Text="⇄" Foreground="#82A8D8" FontSize="22" VerticalAlignment="Center" Margin="5,0"/>
                        <Border Grid.Column="4" Grid.Row="0" Background="#202A38" CornerRadius="12" Padding="12" Margin="6,4,0,4">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="↔  GRID" Foreground="#8FB8EE" FontWeight="Bold" FontSize="12"/>
                                <TextBlock x:Name="GridPowerText" Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                <TextBlock Text="Import / export" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="BatteryStatePanel" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Background="#29313A" BorderBrush="#46515D" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,4,6,4">
                            <StackPanel VerticalAlignment="Center">
                                <DockPanel>
                                    <TextBlock Text="▣  BATTERY" Foreground="#83CBA6" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock x:Name="BatteryStateText" Text="IDLE" Foreground="#C0C8D2" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock x:Name="BatterySocText" Text="— %" FontSize="25" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="BatteryPowerText" Text="— kW" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock x:Name="BatteryEnergyText" Text="— / 40 kWh" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,5"/>
                                <Border Background="#3A4652" CornerRadius="4" Height="6" Width="150" HorizontalAlignment="Left" ClipToBounds="True">
                                    <Border x:Name="BatterySocBar" Background="#70B8A2" Height="6" Width="0" HorizontalAlignment="Left" CornerRadius="4"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="3" Grid.ColumnSpan="2" Grid.Row="1" Text="Battery ↔ Home" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                    <Border Grid.Row="2" Background="#292F38" CornerRadius="8" Padding="8" Margin="0,6,0,0">
                        <TextBlock x:Name="TelemetryStatusText" Text="Read-only monitoring · waiting for connection" Foreground="{StaticResource MutedBrush}" FontSize="11" TextAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1">
                <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="14" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="TODAY'S ENERGY ACCOUNT" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Grid imported" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ImportedKwhText" Grid.Column="1" Text="— kWh"/></Grid>
                        <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Grid exported" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ExportedKwhText" Grid.Column="1" Text="— kWh"/></Grid>
                        
                        <Separator Background="#3A414B" Margin="0,8"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Net energy value" FontWeight="SemiBold"/><TextBlock x:Name="NetEnergyValueText" Grid.Column="1" Text="—" FontWeight="SemiBold"/></Grid>
                        <TextBlock Text="Excludes daily supply charges, subscription and other bill adjustments." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <TextBlock x:Name="AmberStatusText" Text="Amber usage and price intervals will appear here." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3" Margin="0,8,0,0" MinHeight="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="SIGENERGY DAILY ENERGY" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBlock Text="Modbus counters + live power integration" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,7"/>
                    
                    <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Solar generated" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SigDailySolarText" Grid.Column="1" Text="— kWh"/></Grid>
                    <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Home load · estimated" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SigDailyLoadText" Grid.Column="1" Text="— kWh"/></Grid>
                    <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Battery charged" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SigDailyChargeText" Grid.Column="1" Text="— kWh"/></Grid>
                    <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Battery discharged" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SigDailyDischargeText" Grid.Column="1" Text="— kWh"/></Grid>
                    <TextBlock x:Name="SigDailyStatusText" Text="Reading native inverter daily counters where available." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="AMBER FEED-IN PRICE · 30-MIN BLOCKS" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock DockPanel.Dock="Right" Text="c/kWh · low / forecast / high" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                    </DockPanel>
                    <Canvas x:Name="FeedInChartCanvas" Grid.Row="1" ClipToBounds="True" SizeChanged="FeedInChartCanvas_SizeChanged" MouseMove="FeedInChartCanvas_MouseMove" MouseLeave="FeedInChartCanvas_MouseLeave"/>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="4" Text="Daily battery charge/discharge use native Modbus counters. Grid import/export are integrated from live CT power; PV daily generation uses an undocumented plant counter when available. All monitoring is read-only." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,6,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
