<Window x:Class="AmberSigenergy.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="AmberSigenergy.ico" Title="Amber + Sigenergy" Height="960" Width="1180"
        MinHeight="850" MinWidth="960" WindowState="Maximized"
        Background="#15181D" WindowStartupLocation="CenterScreen" Closing="MainWindow_Closing">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,22">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="ENERGY CONTROL" Foreground="#D99A32" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="Amber + Sigenergy" FontSize="30" FontWeight="SemiBold" Margin="0,3,0,0"/>
                <TextBlock Text="EC 10.0 SP  ·  40 kWh battery" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#252A32" CornerRadius="16" Padding="14,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#E0A13B" Margin="0,0,9,0"/>
                    <TextBlock x:Name="ConnectionStatusText" Text="Not connected" Foreground="#D7DCE2" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
                    <Button DockPanel.Dock="Right" Content="Connect Amber" Click="ConnectAmber_Click" Padding="16,9" Margin="0,0,12,0" Background="#D99A32" Foreground="#17191D" BorderThickness="0" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,18">
            <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="IMPORT PRICE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="ImportPriceText" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="c/kWh · Amber general" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="EXPORT PRICE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="ExportPriceText" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="c/kWh · Amber feed-in" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="EARNED TODAY" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="EarnedTodayText" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="Gross export credit estimate" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18">
                <StackPanel><TextBlock Text="IMPORT COST TODAY" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="ImportCostTodayText" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="Gross usage cost estimate" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="22" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="LIVE ENERGY FLOW" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="Live inverter readings · read-only Modbus TCP." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,20" FontSize="12"/>
                    <Grid Height="245">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="SOLAR" Foreground="#D99A32" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="SolarPowerText" Text="— kW" FontSize="24" Margin="0,8"/>
                            <TextBlock Text="PV generation" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="BATTERY" Foreground="#70B8A2" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="BatterySocText" Text="— %" FontSize="28" Margin="0,8"/>
                            <TextBlock x:Name="BatteryEnergyText" Text="— / 40 kWh" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBlock x:Name="BatteryPowerText" Text="— kW" FontSize="16" Margin="0,12,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="GRID" Foreground="#82A8D8" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="GridPowerText" Text="—" FontSize="22" Margin="0,8"/>
                            <TextBlock Text="Import / export" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="HOME LOAD" Foreground="#D99A32" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="HomeLoadText" Text="—" FontSize="22" Margin="0,8"/>
                            <TextBlock Text="Estimated live usage" Foreground="{StaticResource MutedBrush}" FontSize="11" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Border Background="#292F38" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                        <TextBlock x:Name="TelemetryStatusText" Text="Read-only monitoring · waiting for connection" Foreground="{StaticResource MutedBrush}" FontSize="11" TextAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1">
                <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="TODAY'S ENERGY ACCOUNT" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Grid imported" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ImportedKwhText" Grid.Column="1" Text="— kWh"/></Grid>
                        <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Grid exported" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ExportedKwhText" Grid.Column="1" Text="— kWh"/></Grid>
                        <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Export earnings" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ExportEarningsText" Grid.Column="1" Text="—" Foreground="#70B8A2"/></Grid>
                        <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Import cost" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ImportCostText" Grid.Column="1" Text="—"/></Grid>
                        <Separator Background="#3A414B" Margin="0,8"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Net energy value" FontWeight="SemiBold"/><TextBlock x:Name="NetEnergyValueText" Grid.Column="1" Text="—" FontWeight="SemiBold"/></Grid>
                        <TextBlock Text="Excludes daily supply charges, subscription and other bill adjustments." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <TextBlock x:Name="AmberStatusText" Text="Amber usage and price intervals will appear here." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="20">
                    <StackPanel>
                        <TextBlock Text="BATTERY" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="40 kWh nameplate capacity" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,15"/>
                        <TextBlock Text="State of charge" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        <Border x:Name="BatterySocBar" Background="#70B8A2" Height="10" Width="0" HorizontalAlignment="Left" CornerRadius="5" Margin="0,8,0,12"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Charge / discharge" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="BatteryPowerSummaryText" Grid.Column="1" Text="— kW"/></Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="SIGENERGY TODAY · ESTIMATED" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Grid imported" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SigDailyImportText" Grid.Column="1" Text="— kWh"/></Grid>
                    <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Grid exported" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SigDailyExportText" Grid.Column="1" Text="— kWh"/></Grid>
                    <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Solar generated" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SigDailySolarText" Grid.Column="1" Text="— kWh"/></Grid>
                    <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Home load" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SigDailyLoadText" Grid.Column="1" Text="— kWh"/></Grid>
                    <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Battery charged" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SigDailyChargeText" Grid.Column="1" Text="— kWh"/></Grid>
                    <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Battery discharged" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SigDailyDischargeText" Grid.Column="1" Text="— kWh"/></Grid>
                    <TextBlock x:Name="SigDailyStatusText" Text="Accumulating live samples from this app." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="AMBER FEED-IN PRICE · 30-MIN BLOCKS" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock DockPanel.Dock="Right" Text="c/kWh · low / forecast / high" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                    </DockPanel>
                    <Canvas x:Name="FeedInChartCanvas" Grid.Row="1" ClipToBounds="True" SizeChanged="FeedInChartCanvas_SizeChanged"/>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="4" Text="Amber interval usage is the source of truth for import costs and export earnings. Sigenergy daily kWh totals are estimates integrated from live read-only power samples; they are not meter-settled values." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,12,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
