<Window x:Class="AmberSigenergy.Desktop.AmberConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect Amber Electric" Height="300" Width="520"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#15181D">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Connect Amber Electric" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="Paste your Amber API token below. It is encrypted for your Windows account and saved locally; it is never sent to this repository." TextWrapping="Wrap" Foreground="#AAB2BE" Margin="0,10,0,16"/>
        <PasswordBox x:Name="TokenInput" Grid.Row="2" Height="38" Padding="9" Background="#252A32" Foreground="White" BorderBrush="#414955"/>
        <TextBlock Grid.Row="3" Text="Create or copy your token from app.amber.com.au/developers. Do not share it with anyone." Foreground="#AAB2BE" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,12,0,0"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" Padding="16,8" Margin="0,0,10,0"/>
            <Button Content="Save &amp; test connection" Click="Save_Click" Padding="16,8" Background="#D99A32" Foreground="#15181D" BorderThickness="0" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
